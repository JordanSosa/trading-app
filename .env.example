# Optional notification channels (leave unset to disable). Never commit .env.
TRADEBOT_DISCORD_WEBHOOK=
TRADEBOT_SLACK_WEBHOOK=
TRADEBOT_TELEGRAM_BOT_TOKEN=
TRADEBOT_TELEGRAM_CHAT_ID=
# Phone push without an account: install the ntfy app and subscribe to a long random topic name.
TRADEBOT_NTFY_TOPIC=
