# Optional notification channels (leave unset to disable). Never commit .env.
# Phone push without an account: install the ntfy app and subscribe to a long random topic name.
COMPOUNDER_NTFY_TOPIC=
COMPOUNDER_DISCORD_WEBHOOK=
COMPOUNDER_SLACK_WEBHOOK=
COMPOUNDER_TELEGRAM_BOT_TOKEN=
COMPOUNDER_TELEGRAM_CHAT_ID=

# Live trading only (run.mode = "live"). Use a key WITHOUT withdrawal permission.
COMPOUNDER_API_KEY=
COMPOUNDER_API_SECRET=
COMPOUNDER_API_PASSWORD=
